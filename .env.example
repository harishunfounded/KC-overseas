# ==============================================================================
# KC Overseas Education - Namakkal Branch
# Environment Variables Configuration Guide
# ==============================================================================

# 1. Lead Notification Email (Supports comma-separated addresses for multiple recipients)
EMAIL_TO=recipient1@studies-overseas.com,recipient2@studies-overseas.com,recipient3@studies-overseas.com
# Set to 'true' if you want 2nd & 3rd recipients in BCC instead of shared TO
EMAIL_USE_BCC=false

# 2. Google Sheets Webhook Dispatch (Permanent Fail-Safe Storage)
LEAD_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx.../exec

# 3. SMTP Mail Server Configuration (Nodemailer)
# Options:
# A) Gmail (requires an App Password):
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=465
#    SMTP_SECURE=true
#    SMTP_USER=your-email@gmail.com
#    SMTP_PASS=your-16-character-app-password
#
# B) Custom Domain SMTP (e.g., Google Workspace, Zoho, SendGrid, Amazon SES):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=leads@studies-overseas.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM="KC Overseas Namakkal Leads <leads@studies-overseas.com>"

# 3. Google Ads & Tag Manager Tracking Keys (Optional - Can also be set in src/config/site.ts)
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_FORM_LABEL=XXXXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=XXXXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=XXXXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
